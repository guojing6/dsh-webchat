{
  "name": "@guojing6/dsh-webchat",
  "version": "4.5.1",
  "description": "DeepSeek Harness Desktop client plugin: one right-sidebar tab for 9 web AI chat sites (DeepSeek, Qwen, Doubao, Kimi, Zhipu, ChatGPT, Gemini, Grok, Z.ai), with a provider switcher, per-site visibility toggles, custom sites with confirmed deletion, reordering, guide card, Ctrl+Q and a session-header button. Desktop-only; the Web surface registers no UI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.1-alpha.3 <0.2.3-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "webchat",
    "web-chat",
    "deepseek",
    "qwen",
    "doubao",
    "kimi",
    "zhipu",
    "yuanbao",
    "chatgpt",
    "gemini"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guojing6/dsh-deepseek-chat.git"
  },
  "homepage": "https://github.com/guojing6/dsh-deepseek-chat#readme",
  "bugs": {
    "url": "https://github.com/guojing6/dsh-deepseek-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "test:sandbox": "node --test --test-isolation=none",
    "check": "node --check lib/client.js && node --check lib/index.js"
  }
}
